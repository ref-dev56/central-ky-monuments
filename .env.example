# Google Apps Script web app URL that receives lead form submissions.
# Without it, the form logs to the console in dev and shows an error in production.
NEXT_PUBLIC_LEAD_ENDPOINT=

# The live site address, used for canonical links, the sitemap and link previews.
# Defaults to https://centralkymonuments.com; set it for a staging site.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key (public) for the request form's spam check.
# The matching secret key lives in the Apps Script's Script properties, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Pre-launch: set to "true" to mark every page noindex and leave the sitemap
# out of robots.txt. Delete it (and redeploy) when the site goes live.
PRELAUNCH_NOINDEX=
